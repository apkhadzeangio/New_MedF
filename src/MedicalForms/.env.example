# Copy this file to ".env" (same folder as manage.py) and fill in the values.
# NEVER commit the real .env file - this repository is public.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Keep 0 on the live site. 1 shows detailed error pages (only for debugging).
DJANGO_DEBUG=0

DJANGO_ALLOWED_HOSTS=medf.pythonanywhere.com

# 1 = cookies only over https (turn on together with "Force HTTPS" on PythonAnywhere)
DJANGO_HTTPS=0

# MySQL (PythonAnywhere -> Databases tab)
DB_NAME=medf$MDF
DB_USER=medf
DB_HOST=medf.mysql.pythonanywhere-services.com
DB_PASSWORD=change-me

# People on the login page: username:Name:password, separated by commas.
# Used by "python manage.py setup_staff".
STAFF_USERS=user1:სახელი1:password1,user2:სახელი2:password2

# Where staff photos are stored (outside the code folder). Default: ~/medf-media
# MEDIA_ROOT=/home/medf/medf-media
