def clear_pdf_cache():
    """Clear Django's 'pdf' cache if configured so LibreOffice renders fresh."""
    try:
        from django.core.cache import caches
        if 'pdf' in caches:
            caches['pdf'].clear()
    except Exception:
        pass


def render_run(run_dir: Path, settings_module: str, dpi: int) -> list[Path]:
    setup_django(settings_module)
    from django.contrib.auth import get_user_model
    from django.core.management import call_command
    from django.db import OperationalError
    from django.test import Client
    from apps.mdf.models import NivForm

    User = get_user_model()
    try:
        User.objects.exists()
    except OperationalError:
        call_command('migrate', verbosity=0)

    if run_dir.exists():
        shutil.rmtree(run_dir)
    run_dir.mkdir(parents=True, exist_ok=True)

    user, created_user = User.objects.get_or_create(username=TEMP_USER)
    created_niv_ids = []
    png_files: list[Path] = []

    try:
        specs = fixed_prescription_specs()
        labeled_ids = []
        for label, fields in specs:
            niv = NivForm.objects.create(**fields)
            created_niv_ids.append(niv.pk)
            labeled_ids.append((label, niv.pk))

        clear_pdf_cache()
        client = Client()
        client.force_login(user)

        for label, pk in labeled_ids:
            url = f'/niv-300-9-a/cover/print/?t={pk}'
            resp = client.get(url, HTTP_HOST='localhost')
            if resp.status_code != 200:
                raise RuntimeError(f'{url} returned HTTP {resp.status_code}')
            ctype = resp.get('Content-Type', '')
            body = b''.join(resp.streaming_content) if getattr(resp, 'streaming', False) else resp.content
            if 'pdf' not in ctype.lower() or not body.startswith(b'%PDF-'):
                raise RuntimeError(f'{url} did not return a valid PDF (Content-Type={ctype!r})')

            pdf_path = run_dir / f'{label}.pdf'
            pdf_path.write_bytes(body)
            prefix = run_dir / label
            subprocess.run(
                ['pdftoppm', '-png', '-r', str(dpi), str(pdf_path), str(prefix)],
                check=True,
            )
            pages = sorted(run_dir.glob(f'{label}-*.png'))
            if not pages:
                raise RuntimeError(f'pdftoppm produced no PNG pages for {pdf_path}')
            png_files.extend(pages)
            digest = hashlib.sha256(body).hexdigest()[:10]
            print(f'  rendered {label}: {len(pages)} page(s), pdf={len(body)} bytes (sha256={digest})')
    finally:
        if created_niv_ids:
            NivForm.objects.filter(pk__in=created_niv_ids).delete()
        if created_user:
            User.objects.filter(pk=user.pk).delete()

    return png_files


def compare_png_dirs(dir_a: Path, dir_b: Path) -> int:
    files_a = sorted(p.name for p in dir_a.glob('*.png'))
    files_b = sorted(p.name for p in dir_b.glob('*.png'))
    if not files_a:
        print(f'ERROR: no PNG files in {dir_a}', file=sys.stderr)
        return 1
    if files_a != files_b:
        print(f'DIFF: page list mismatch:\n  {dir_a}: {files_a}\n  {dir_b}: {files_b}', file=sys.stderr)
        return 1

    diffs = 0
    for name in files_a:
        im_a = Image.open(dir_a / name).convert('RGBA')
        im_b = Image.open(dir_b / name).convert('RGBA')
        if im_a.size != im_b.size:
            print(f'DIFF {name}: dimensions {im_a.size} != {im_b.size}', file=sys.stderr)
            diffs += 1
            continue
        b_a, b_b = im_a.tobytes(), im_b.tobytes()
        if b_a != b_b:
            px = sum(1 for i in range(0, len(b_a), 4) if b_a[i:i + 4] != b_b[i:i + 4])
            rgb_diff = ImageChops.difference(im_a.convert('RGB'), im_b.convert('RGB'))
            a_diff = ImageChops.difference(im_a.getchannel('A'), im_b.getchannel('A'))
            bbox = rgb_diff.getbbox() or a_diff.getbbox()
            print(f'DIFF {name}: {px} differing pixel(s) in bbox {bbox}', file=sys.stderr)
            diffs += 1
        else:
            print(f'OK   {name}: pixel-identical ({im_a.size[0]}x{im_a.size[1]})')

    if diffs:
        print(f'\nFAILED: {diffs} PNG page(s) differ.', file=sys.stderr)
        return 1
    print(f'\nPASSED: all {len(files_a)} PNG page(s) match pixel for pixel.')
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description='Render fixed prescriptions to PDF -> PNG and compare pixel by pixel.'
    )
    parser.add_argument('--save', type=Path, metavar='DIR',
                        help='Render once and save PDF + PNG baseline into DIR.')
    parser.add_argument('--compare', type=Path, metavar='BASELINE_DIR',
                        help='Render a fresh run and compare pixel by pixel against BASELINE_DIR.')
    parser.add_argument('--compare-dirs', nargs=2, type=Path, metavar=('DIR_A', 'DIR_B'),
                        help='Compare two existing PNG directories pixel by pixel.')
    parser.add_argument('--out', type=Path, default=DEFAULT_OUT,
                        help=f'Working output directory (default: {DEFAULT_OUT}).')
    parser.add_argument('--dpi', type=int, default=150, help='PNG rasterization DPI (default: 150).')
    parser.add_argument('--settings', default=DEFAULT_SETTINGS,
                        help=f'Django settings module (default: {DEFAULT_SETTINGS}).')
    args = parser.parse_args()

    if args.compare_dirs:
        return compare_png_dirs(args.compare_dirs[0], args.compare_dirs[1])

    missing = check_binaries()
    if missing:
        print('ERROR: missing required system tools: ' + ', '.join(missing), file=sys.stderr)
        return 1

    if args.save:
        print(f'Recording prescription PDF baseline into {args.save} ...')
        render_run(args.save, args.settings, args.dpi)
        print('Saved.')
        return 0

    if args.compare:
        if not args.compare.is_dir():
            print(f'ERROR: baseline directory does not exist: {args.compare}', file=sys.stderr)
            return 1
        cand_dir = args.out / 'current'
        print(f'Rendering current prescriptions into {cand_dir} ...')
        render_run(cand_dir, args.settings, args.dpi)
        print(f'\nComparing against {args.compare}:')
        return compare_png_dirs(args.compare, cand_dir)

    # Default mode: two independent runs compared pixel by pixel
    run1 = args.out / 'run1'
    run2 = args.out / 'run2'
    print(f'Run 1 -> {run1}')
    render_run(run1, args.settings, args.dpi)
    print(f'Run 2 -> {run2}')
    render_run(run2, args.settings, args.dpi)
    print('\nComparing Run 1 vs Run 2:')
    return compare_png_dirs(run1, run2)


if __name__ == '__main__':
    sys.exit(main())
