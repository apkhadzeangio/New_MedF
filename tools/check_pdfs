#!/usr/bin/env python3
"""Render fixed synthetic prescriptions to PDF via /niv-300-9-a/cover/print/?t=<id>,
convert every page to PNG, and compare two runs pixel by pixel (exit code 1 on any diff).

Requires LibreOffice (soffice / libreoffice) and pdftoppm (poppler-utils).
"""
import argparse
import hashlib
import os
import shutil
import subprocess
import sys
from pathlib import Path

from PIL import Image, ImageChops

REPO_ROOT = Path(__file__).resolve().parent.parent
DJANGO_DIR = REPO_ROOT / 'src' / 'MedicalForms'
DEFAULT_SETTINGS = 'MedicalForms.settings.dev'
DEFAULT_OUT = REPO_ROOT / 'tools' / 'out' / 'pdfs'

TEMP_USER = 'medf_pdf_check_user'


def check_binaries() -> list[str]:
    missing = []
    if not (shutil.which('soffice') or shutil.which('libreoffice')):
        missing.append('LibreOffice (soffice / libreoffice)')
    if not shutil.which('pdftoppm'):
        missing.append('pdftoppm (poppler-utils)')
    return missing


def setup_django(settings_module: str):
    if str(DJANGO_DIR) not in sys.path:
        sys.path.insert(0, str(DJANGO_DIR))
    os.environ.setdefault('DJANGO_SETTINGS_MODULE', settings_module)
    import django
    django.setup()


